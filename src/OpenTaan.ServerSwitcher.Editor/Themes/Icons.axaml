  <!-- App mark: </> brackets around a padlock (24×24 grid). -->
  <StreamGeometry x:Key="IconLogo">M7,6 L2,12 L7,18 M17,6 L22,12 L17,18 M9.7,11 H14.3 A1.2,1.2 0 0 1 15.5,12.2 V15.8 A1.2,1.2 0 0 1 14.3,17 H9.7 A1.2,1.2 0 0 1 8.5,15.8 V12.2 A1.2,1.2 0 0 1 9.7,11 Z M10,11 V9.5 A2,2 0 0 1 14,9.5 V11</StreamGeometry>
