<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Base ===== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="fonts:Inter#Inter, $Default" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Stroke icon: 16×16 geometry from Icons.axaml. Stroke follows the parent control's Foreground. -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}" />
  </Style>

  <!-- ===== Text roles ===== -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.subhead">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.tag">
    <Setter Property="Foreground" Value="{StaticResource TagBrush}" />
  </Style>
  <Style Selector="TextBlock.attr">
    <Setter Property="Foreground" Value="{StaticResource AttrBrush}" />
  </Style>
  <Style Selector="TextBlock.str">
    <Setter Property="Foreground" Value="{StaticResource StringBrush}" />
  </Style>
  <Style Selector="TextBlock.punct">
    <Setter Property="Foreground" Value="{StaticResource PunctuationBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{StaticResource AttrBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Small pill: "edited" marker, counters, status badges. -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.pill.amber">
    <Setter Property="Background" Value="{StaticResource AmberBadgeBgBrush}" />
  </Style>
  <Style Selector="Border.pill.amber > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AttrBrush}" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{StaticResource AttrBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Card / panel -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.well">
    <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource ControlBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#242931" />
    <Setter Property="BorderBrush" Value="#454C57" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2A3039" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#5A626D" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#5A9EE3" />
  </Style>

  <Style Selector="Button.ghost, Button.icon, Button.link, Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#B5D8FB" />
  </Style>
  <Style Selector="Button.row">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.row.selected">
    <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ErrorSoftBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1D1516" />
    <Setter Property="BorderBrush" Value="#6A3C3C" />
    <Setter Property="Foreground" Value="{StaticResource ErrorSoftBrush}" />
  </Style>
  <Style Selector="Button.dashed">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- View tabs (Tree / Table / Raw XML / Changes) -->
  <Style Selector="Button.tab">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.tab.active">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- ===== Inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="TextBox.cell">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.changed /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource ChangedBorderBrush}" />
  </Style>
  <Style Selector="TextBox.error /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="TextBox.cell.changed">
    <Setter Property="Foreground" Value="{StaticResource AttrBrush}" />
  </Style>
  <Style Selector="TextBox.cell.error">
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="30,4,8,4" />
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
  </Style>

  <!-- ===== Tree ===== -->
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- ===== Misc ===== -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    <Setter Property="MinWidth" Value="1" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource ControlBgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>
</Styles>
