<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenTaan.ServerSwitcher.Editor.App"
             Name="OpenTaan Server Switcher"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://OpenTaanServerSwitcher/Themes/Palette.axaml" />
        <ResourceInclude Source="avares://OpenTaanServerSwitcher/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://OpenTaanServerSwitcher/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
