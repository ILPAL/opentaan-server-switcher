<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia desktop editor (Windows, macOS, Linux).
    All file-format and editing logic lives in OpenTaan.ServerSwitcher.Core; this project is UI only,
    so a future .NET MAUI front end only has to replace this project.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OpenTaanServerSwitcher</AssemblyName>
    <RootNamespace>OpenTaan.ServerSwitcher.Editor</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTaan.ServerSwitcher.Core\OpenTaan.ServerSwitcher.Core.csproj" />
  </ItemGroup>

</Project>
