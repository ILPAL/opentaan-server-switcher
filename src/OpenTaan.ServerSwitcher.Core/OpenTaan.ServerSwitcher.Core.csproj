<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-free core: .0m container format, config tree model, editing (undo/redo, change tracking),
    validation and XML/JSON interop. Kept free of any UI framework so a future .NET MAUI front end
    can reuse it unchanged.
  -->
  <PropertyGroup>
    <RootNamespace>OpenTaan.ServerSwitcher.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTaan.ServerSwitcher.Core.Tests" />
  </ItemGroup>

</Project>
